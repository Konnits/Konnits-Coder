{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Qwen Frontend",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}
